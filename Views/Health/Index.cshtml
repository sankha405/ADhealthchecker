@model IEnumerable<ADHealthChecker.Models.HealthResult>

<h2>Health Assessment</h2>

<p>
    <a asp-controller="Health" asp-action="RunAssessment" class="btn btn-primary">Run Assessment</a>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Home</a>
</p>

@{
    var overall = ViewBag.OverallHealthScore as int? ?? -1;
    string scoreClass = "";
    if (overall >= 0)
    {
        if (overall >= 90) scoreClass = "bg-success text-white";
        else if (overall >= 70) scoreClass = "bg-warning text-dark";
        else scoreClass = "bg-danger text-white";
    }
}

@if (overall >= 0)
{
    <div class="mb-3">
        <div class="p-3 @scoreClass" style="width:150px;text-align:center;font-size:1.5rem;border-radius:6px;">@overall</div>
        <div class="mt-2">Overall Health Score</div>
    </div>
}
@{
    var grade = ViewBag.OverallGrade as string ?? string.Empty;
}

@if (!string.IsNullOrEmpty(grade))
{
    <div class="mb-3">Grade: <strong>@grade</strong></div>
}

@if (Model != null && Model.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Check</th>
                <th>Status</th>
                <th>Score</th>
                <th>Recommendation</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.CheckName</td>
                <td>@r.Status</td>
                <td>@r.Score</td>
                <td>@r.Recommendation</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p>No results yet. Click "Run Assessment" to generate sample results.</p>
}

@* Collapsible raw outputs per check *@
@if (Model != null && Model.Any())
{
    var list = Model.ToList();
    <h4>Raw Command Output</h4>
    @for (int i = 0; i < list.Count; i++)
    {
        var r = list[i];
        <div class="mb-2">
            <div class="d-flex justify-content-between align-items-center">
                <div><strong>@r.CheckName</strong></div>
                <div>
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#raw@i" aria-expanded="false" aria-controls="raw@i">Show Output</button>
                </div>
            </div>
            <div class="collapse mt-2" id="raw@i">
                <pre style="max-height:300px;overflow:auto;">@(string.IsNullOrEmpty(r.RawOutput) ? "(no output)" : r.RawOutput)</pre>
            </div>
        </div>
    }
}
